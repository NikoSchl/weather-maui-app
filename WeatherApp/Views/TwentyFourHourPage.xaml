<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WeatherApp.Views.TwentyFourHourPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:WeatherApp.Resources.Localization"
    xmlns:models="clr-namespace:WeatherApp.Models"
    xmlns:viewModels="clr-namespace:WeatherApp.ViewModels"
    Title="24 Hour Preview"
    x:DataType="viewModels:TwentyFourHourViewModel">
    <StackLayout>
        <Label
            HorizontalOptions="Center"
            Text="24 h Preview"
            VerticalOptions="Center" />

        <Button Margin="20,5,20,5" Text="5h" />
        <Button Margin="20,5,20,5" Text="6h" />


    </StackLayout>
</ContentPage>