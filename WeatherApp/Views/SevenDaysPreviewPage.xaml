<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WeatherApp.Views.SevenDaysPreviewPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:localization="clr-namespace:WeatherApp.Resources.Localization"
    xmlns:viewModels="clr-namespace:WeatherApp.ViewModels"
    Title="7 Days Preview"
    x:DataType="viewModels:SevenDayViewModel">

    <StackLayout>
        <Label
            HorizontalOptions="Center"
            Text="7 Days Preview"
            VerticalOptions="Center" />
        <Entry Text="{Binding Test}" />
        <Button Margin="20,5,20,5" Text="Mo" />
        <Button
            Margin="20,5,20,5"
            Clicked="Button_Clicked"
            Text="Di" />
        <Entry Placeholder="e" />
    </StackLayout>
</ContentPage>