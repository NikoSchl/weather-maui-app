<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WeatherApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:collection="clr-namespace:WeatherApp.Collections"
    xmlns:converters="clr-namespace:WeatherApp.Converters"
    xmlns:localization="clr-namespace:WeatherApp.Resources.Localization"
    xmlns:models="clr-namespace:WeatherApp.Models"
    xmlns:viewModels="clr-namespace:WeatherApp.ViewModels"
    x:DataType="viewModels:MainViewModel">

    <StackLayout Padding="30,0" Spacing="25">

        <Label
            Margin="20"
            Style="{StaticResource Headline}"
            Text="Sonnig bis Wolkig" />

        <Label Text="{Binding HourlyForecast.Date}" />

        <Image
            Aspect="AspectFit"
            HeightRequest="185"
            Source="son_wol.png" />

        <Label Style="{StaticResource Headline}" Text="{Binding HourlyForecast.Temperatur}" />

        <Label Style="{StaticResource SubHeadline}" Text="Welcome to my Weather" />


    </StackLayout>

</ContentPage>
